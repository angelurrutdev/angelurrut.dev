---
// ICONS 
import GitHub from '@/assets/social/github.svg';
import Link from '@/assets/icons/link.svg'

// COMPONENTS
import ShinyBadge from "../components/ShinyBadge.astro";
import Subtitle from "../components/Subtitle.astro";
import ModeWatcher from "./ModeWatcher.svelte";
import { Image } from "astro:assets";
import ButtonReed from './ButtonReed.astro';

// I18N
import { getProjects } from "@/const/projects"; // 👈 nueva función que recibe el locale
import { getI18N } from "@/i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const PROJECTS = getProjects(currentLocale ?? "es");


const currentURL = new URL(Astro.request.url);
const mostrarEN = currentURL.pathname.startsWith("/en");

function getBadgeText(project: Project) {
  if (project.latest) return "latest";
  if (project.updated) return "updated";
  return "";
}

interface Project {
  latest?: boolean;
  updated?: boolean;
}
---

<Subtitle>{i18n.PROJECTS_PRE_TITLE}</Subtitle>

<section class="grid flex-col grid-cols-1 gap-3 max-w-2xl duration-500 delay-100 fill-mode-backwards md:max-w-5xl md:grid-cols-2">
  {
    PROJECTS.map(
      ({
        id,
        icon,
        title,
        description,
        github_url,
        url,
        tags,
        latest,
        updated,
        project_image,
      }) => (
        <ModeWatcher client:load transition:name="box">
          <div class="flex flex-col space-y-3">
            <div class="flex justify-between items-center w-full">
              <div class="flex items-center space-x-[10px]">
                <img src={icon} alt={title} class="rounded-md size-6" />
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-[6px] font-medium decoration-neutral-500 decoration-dotted underline-offset-[5px] hover:underline"
                >
                  <span>{title}</span>
                  <Link />
                </a>
              </div>
              <div class="flex gap-2 items-center">
                
                  <ButtonReed href={`${mostrarEN ? '/en/project' : '/project'}/${id}`} label={i18n.PROJECTS_SEE_MORE}/>
                <ShinyBadge>{getBadgeText({ latest, updated })}</ShinyBadge>
                {github_url && (
                  <a
                    href={github_url}
                    title={`View ${title} repository on GitHub`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="opacity-75 transition-opacity duration-100 hover:opacity-100"
                  >
                    <GitHub class="size-5" />
                  </a>
                )}
              </div>
            </div>
            <p class="text-sm font-semibold truncate dark:text-neutral-400">
              {description}
            </p>
            {project_image && (
              <a href={url} target="_blank">
                <Image
                  transition:name={project_image}
                  src={project_image}
                  alt={`Imagen de ${title}`}
                  width={480}
                  height={270}
                  loading="lazy"
                  class="object-cover rounded-md transition duration-500 hover:scale-90"
                />
              </a>
            )}
            <div class="flex overflow-x-auto items-center py-1 font-mono md:space-x-2">
              {tags.map((tag) => (
                <div class="flex items-center space-x-1 mx-1">
                  <span class={`inline-flex items-center px-2 py-1 space-x-2 font-mono text-xs font-medium rounded-md border cursor-default border-neutral-300 bg-neutral-300 text-gray-800 dark:border-neutral-800 dark:bg-neutral-800/60 dark:text-neutral-300 ${tag.class}`}>
                    <tag.icon class="mx-1 size-4" />
                    {tag.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </ModeWatcher>
      )
    )
  }
</section>
