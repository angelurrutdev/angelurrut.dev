---
import SocialPill from "./SocialPill.astro";
import Mail from '@/assets/icons/mail.svg'
import LinkedIn from '@/assets/icons/linkedin.svg'


import { SOCIAL } from "@/const/social";
import { getI18N } from "@/i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section
  class="flex flex-col justify-center items-center py-12 text-gray-800 dark:text-white"
>
  <div class="">
    <h2
      class=" my-1 md:my-2 text-2xl font-bold text-center md:text-5xl  text-pretty"
    >
      {i18n.HAVE_PROJECT_TITLE}
    </h2>
    <p class="mb-1 md:mb-2 text-4xl font-semibold text-center">
      {i18n.HAVE_PROJECT_SUBTITLE}
    </p>
  </div>
  <div class="flex flex-row items-center my-2">
    {
      SOCIAL.slice(0,2).map(({ url, image, name, label, id }) => {
        const isEmail = id === 'email';
        const hrefValue = isEmail ? `mailto:${url}` : url;

        return (
          <a
            href={hrefValue}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label ?? name}
            class="inline-flex items-center space-x-3 justify-center whitespace-nowrap rounded-md text-sm font-medium focus-visible:outline-none focus-visible:ring-1 disabled:pointer-events-none disabled:opacity-50 dark:focus-visible:ring-neutral-700 focus-visible:ring-neutral-500 hover:bg-neutral-200 hover:text-neutral-900 dark:hover:bg-neutral-800 dark:hover:text-neutral-50 opacity-80 transition-opacity duration-150 hover:opacity-100   "
          >
            {image?.logo && <image.logo class="size-5 mx-1"/>}
            <span class="text-md m-2">{name} </span>
          </a>
        );
      })
    }
  </div>
</section>