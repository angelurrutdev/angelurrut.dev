---
import Subtitle from "./Subtitle.astro";

import { OTHERPROJECTS } from "@/const/otherProjects";
import ButtonReed from "./ButtonReed.astro";

import { getI18N } from "@/i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const currentURL = new URL(Astro.request.url);
const mostrarEN = currentURL.pathname.startsWith("/en");

---

<Subtitle>Otros Proyectos</Subtitle>
<section
  class="rounded-md border border-neutral-300 p-3 dark:border-neutral-800"
>
  {
    OTHERPROJECTS.map(({ id, title, href, description }) => (
      <div class="mb-3">
        <a
          href={href}
          class="text-md flex items-center space-x-2 font-medium decoration-neutral-500 decoration-dotted underline-offset-[5px] duration-150 hover:underline hover:opacity-80 md:text-lg"
        >
          <span>{title}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide-icon lucide lucide-chevron-right block flex-shrink-0 text-neutral-500 dark:text-neutral-400 md:hidden"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
        <div class="flex items-center justify-between">
          <p class="text-pretty text-sm dark:text-neutral-400">{description}</p>
          <ButtonReed href={`${mostrarEN ? '/en/project' : '/project'}/${id}`} label={i18n.PROJECTS_SEE_MORE}/>
        </div>
      </div>
    ))
  }
</section>
