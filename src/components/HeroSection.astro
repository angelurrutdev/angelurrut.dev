---
import { getI18N } from "@/i18n";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<div class="max-w-2xl md:max-w-5xl">
  <h1
    class="mb-2 text-4xl font-bold tracking-tight text-center text-neutral-800 sm:text-5xl dark:text-white"
  >
    {i18n.HERO_TITLE}
  </h1>
  <p
    set:html={i18n.HERO_DESCRIPTION}
    class="justify-center items-center mx-auto max-w-xl text-center text-pretty"
  />
</div>
